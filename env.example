# ============================================
# GEMPAR Environment Variables
# Copy file ini ke .env.local (untuk local dev)
# Atau set via Vercel Dashboard (untuk production)
# ============================================

# --------------------------------------------
# SUPABASE - WAJIB
# --------------------------------------------
# Dapatkan dari: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --------------------------------------------
# APP CONFIG - WAJIB
# --------------------------------------------
NEXT_PUBLIC_APP_URL=https://gempar.vercel.app
NEXT_PUBLIC_APP_NAME=GEMPAR

# --------------------------------------------
# AUTH - OPSIONAL (untuk custom JWT)
# --------------------------------------------
# SUPABASE_JWT_SECRET=your-jwt-secret

# --------------------------------------------
# PWA - OPSIONAL
# --------------------------------------------
# NEXT_PUBLIC_PWA_SHORT_NAME=GEMPAR
# NEXT_PUBLIC_PWA_THEME_COLOR=#2E7D32
# NEXT_PUBLIC_PWA_BACKGROUND_COLOR=#FAFBFA

# --------------------------------------------
# FEATURE FLAGS - OPSIONAL
# --------------------------------------------
# NEXT_PUBLIC_ENABLE_OFFLINE=true
# NEXT_PUBLIC_ENABLE_PUSH_NOTIF=true
# NEXT_PUBLIC_ENABLE_ANALYTICS=false

# --------------------------------------------
# ADMIN - OPSIONAL (untuk seeding admin)
# --------------------------------------------
# ADMIN_EMAIL=admin@gempar.id
# ADMIN_PASSWORD=your-secure-password
